{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "staticfiles",
  "functions": {
    "school_ko_site/wsgi.py": {
      "maxDuration": 60
    }
  },
  "build": {
    "command": "bash vercel_build.sh",
    "env": {
      "PYTHON_VERSION": "3.12"
    }
  },
  "github": {
    "silent": true
  }
}
