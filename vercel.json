{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "vercel-python",
      "config": {
        "includeFiles": [
          "templates/",
          "staticfiles/",
          "school_ko_site/",
          "images/",
          "manage.py"
        ],
        "build": "python manage.py collectstatic --noinput"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
